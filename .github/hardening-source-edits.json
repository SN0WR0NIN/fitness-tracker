      [4195,4195,"","Privacy and recovery regression without retries\n        run: npx playwright test --config=playwright.config.cjs e2e/privacy-recovery.spec.cjs --retries=0\n      - name: Install and verify scheduled backup v7 in disposable database only\n        run: |\n          npx prisma db execute --schema prisma/schema.prisma --file prisma/points-log-backup-v7.sql\n          node scripts/check-v7-snapshot.cjs\n      - name: Restore synthetic operational fixture into a new empty isolated database\n        env:\n          PG_CONTAINER: ${{ job.services.postgres.id }}\n          DRILL_TARGET_DATABASE_URL: postgresql://postgres:postgres@127.0.0.1:5432/fitness_tracker_restore_drill\n        run: |\n          docker exec \"$PG_CONTAINER\" createdb -U postgres fitness_tracker_restore_drill\n          docker exec \"$PG_CONTAINER\" pg_dump -U postgres --schema-only --no-owner --no-privileges -n public -n app_internal fitness_tracker_e2e > /tmp/fixture-schema.sql\n          docker exec -i \"$PG_CONTAINER\" psql -U postgres -v ON_ERROR_STOP=1 fitness_tracker_restore_drill < /tmp/fixture-schema.sql\n          node scripts/restore-operational-drill.cjs /tmp/kg-hardening-fixture.json --confirm-disposable\n          if node scripts/restore-operational-drill.cjs /tmp/kg-hardening-fixture.json --confirm-disposable; then\n            echo \"ERROR: populated target was not rejected\"; exit 1\n          fi\n      - name: "],
